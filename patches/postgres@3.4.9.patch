diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..0bc8c7b9ce537052871e5a0b486c485b2b53638e 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -159,6 +159,15 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     if (terminated)
       return queryError(q, Errors.connection('CONNECTION_DESTROYED', options))
 
+    // The socket closed without a FATAL (a clean FIN): reject now, as the
+    // deferred write to the null socket would throw outside any promise.
+    // True, so that the handlers of begin and reserve (`execute(q) || move(c, full)`)
+    // leave the connection in `closed`, where the pool opens it again.
+    if (!socket) {
+      queryError(q, Errors.connection('CONNECTION_CLOSED', options))
+      return true
+    }
+
     if (stream)
       return queryError(q, Errors.generic('COPY_IN_PROGRESS', 'You cannot execute queries during copy'))
 
