{
  // One program for the whole monorepo. Nothing is emitted: Node runs the
  // TypeScript sources directly (type stripping), so `pnpm build` is a type-check.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Required for Node type stripping: erasable syntax only, explicit `import type`, `.ts` imports.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["apps/*/src", "apps/*/test", "packages/*/src", "packages/*/test", "test", "evals", "scripts"]
}
