{
  "name": "arianna",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm --filter @arianna/hud typecheck",
    "test": "node --test \"{apps,packages}/*/test/**/*.test.ts\" \"test/**/*.test.ts\" \".claude/hooks/*.test.js\"",
    "test:db": "pnpm db:up && node --test --test-timeout=60000 \"apps/*/test-db/**/*.test.ts\"",
    "lint": "eslint . --max-warnings 0",
    "eval": "node packages/evals/src/cli.ts deterministic",
    "eval:models": "node packages/evals/src/cli.ts models",
    "eval:live": "node packages/evals/src/cli.ts live",
    "check": "pnpm build && pnpm test && pnpm lint && pnpm eval",
    "db:up": "node scripts/compose.ts up --detach --wait",
    "db:down": "node scripts/compose.ts down",
    "db:migrate": "node apps/core/src/db/migrate-cli.ts",
    "arianna:init": "node apps/installer/src/cli.ts init",
    "arianna:install": "node apps/installer/src/cli.ts install",
    "arianna:doctor": "node apps/installer/src/cli.ts doctor",
    "arianna:models": "node apps/installer/src/cli.ts models",
    "vault:init": "node scripts/vault.ts init",
    "vault:edit": "node scripts/vault.ts edit",
    "voice:sync": "node scripts/voice.ts sync",
    "voice:lock": "node scripts/voice.ts lock",
    "test:voice": "node scripts/voice.ts test",
    "voice:vapid": "node scripts/voice.ts vapid",
    "notifier:build": "node apps/notifier/src/cli.ts",
    "kb:capture": "node scripts/kb-capture.ts",
    "agency:import": "node scripts/agency-import.ts",
    "start": "node apps/core/src/main.ts",
    "hud:dev": "pnpm --filter @arianna/hud dev",
    "hud:build": "pnpm --filter @arianna/hud build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@arianna/agents": "workspace:*",
    "@arianna/config": "workspace:*",
    "@arianna/executors": "workspace:*",
    "@arianna/policy": "workspace:*",
    "@arianna/router": "workspace:*",
    "@arianna/vault": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/ws": "8.18.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
