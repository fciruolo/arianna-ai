{
  "name": "arianna",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"{apps,packages}/*/test/**/*.test.ts\" \"test/**/*.test.ts\" \".claude/hooks/*.test.js\"",
    "lint": "eslint . --max-warnings 0",
    "eval": "node packages/evals/src/cli.ts deterministic",
    "eval:models": "node packages/evals/src/cli.ts models",
    "eval:live": "node packages/evals/src/cli.ts live",
    "check": "pnpm build && pnpm test && pnpm lint && pnpm eval",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@arianna/policy": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
